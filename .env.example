# ==============================================================
# ShikshaSaathi Voice — Environment Variables
# ==============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ==============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shikshasaathi
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Test Database ----
TEST_DATABASE_NAME=shikshasaathi_test

# ---- AI Providers (auto | mock | gnani | gemini) ----
# auto = use the real provider when the matching API key is set, otherwise mock.
# Tests always force mock and never call the network.
STT_PROVIDER=auto
TTS_PROVIDER=auto
# auto = real Gnani when GNANI_API_KEY is set, otherwise a clear offline mock.
# Use "mock" to force the offline mock (synthetic tone, labelled in the UI).
VOICE_CLONE_PROVIDER=auto
GNANI_API_KEY=
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_EVON_ENDPOINT=
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_VOICE_CLONE_ENDPOINT=https://api.vachana.ai/api/v1/tts/voice-clone/embeddings
# Timbre v3.0 + Lakshmi: one voice speaks kn/hi/en. Do not pair Lakshmi/Shivani with timbre-v2.5.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Lakshmi

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- RAG / Embeddings ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Lenient retrieval floor (0..1). Chunks below it are dropped, but the best chunk
# is still passed to the LLM so the floor never decides "not covered" on its own.
# Lower = more permissive (cross-lingual matches score lower than same-language ones).
SIMILARITY_THRESHOLD=0.10
# When true, /ask returns a non-secret retrieval debug block and the UI shows a
# collapsible "Debug (retrieval)" section with chunk ids and scores.
RAG_DEBUG=false

# ---- LLM Configuration ----
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
