# ==============================================================
# ShikshaSaathi Voice — Environment Variables
# ==============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ==============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shikshasaathi
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Test Database ----
TEST_DATABASE_NAME=shikshasaathi_test

# ---- Gnani APIs ----
GNANI_API_KEY=
GNANI_PRISMA_ENDPOINT=
GNANI_EVON_ENDPOINT=
GNANI_TIMBRE_ENDPOINT=
GNANI_VOICE_CLONE_ENDPOINT=

# ---- LLM ----
# "mock" (default) or "gemini". Unset behaves like "mock".
LLM_PROVIDER=mock
# Free-tier text model, see https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-4-hydrogen
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
